# ── Fortuno ortam değişkenleri ───────────────────────────────────────────────
# Bu dosyayı .env adıyla kopyala ve değerleri doldur:  cp .env.example .env
# .env asla git'e eklenmez. Gerçek key/secret'ları SADECE .env'e yaz.
#
# ⚠️ Gizli değerlere VITE_ öneki KOYMA — Vite bu önekli değişkenleri
#    tarayıcı paketine gömer ve herkes görebilir.

# Google Gemini API key — https://aistudio.google.com/apikey
# Boş bırakılırsa sohbet yalnızca hazır yanıtlarla çalışır.
GEMINI_API_KEY=

# Kullanılacak Gemini modelleri (opsiyonel). Ana model yoğun/yanıtsızsa yedeğe geçilir.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Oturum çerezlerini imzalayan gizli anahtar. Production'da ZORUNLU.
# Üretmek için:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Opsiyonel
# PORT=3001
# NEWS_REFRESH_MINUTES=30   # haber akışlarının yenilenme aralığı (dakika)
# DB_PATH=server/data/fortuno.db
